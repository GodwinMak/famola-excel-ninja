NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=famola_erp
DB_USER=famola_app
DB_PASSWORD=changeme

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

SEED_ADMIN_EMAIL=admin@example.com
