# The backend's origin. Used two ways:
# - `vite dev`/`vite preview`: only as the target for the local /api proxy (vite.config.ts).
# - `vite build` (the real production bundle): baked directly into API_BASE
#   (utils/authToken.ts) since the built static files have no proxy at runtime —
#   every API call goes straight to this origin. Must be set BEFORE running
#   `npm run build`, since Vite bakes it in at build time, not read at runtime.
VITE_API_BASE_URL="https://backend.famola.co.tz"

